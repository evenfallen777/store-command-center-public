# Python
venv/
__pycache__/
*.pyc
*.pyo

# Local config / secrets
.env
# Hand-made copies carry the same live keys as .env but are not matched by the
# rule above (e.g. .env.bak, .env.2026-01-01, .env.old). Keep the tracked template.
.env.*
!.env.example

# Runtime data — store.db holds credentials (settings table); never commit it.
# A fresh DB is created on first run (init_db). The -shm/-wal siblings are
# SQLite's live journal files — transient, but present whenever the app runs.
store.db
store.db-*
# Dotted copies (store.db.pre-<version>.bak, store.db.2026-01-01 …) — the
# `store.db-*` rule above only matches the dash form, so it misses these.
store.db.*
*.sqlite
*.sqlite.gz
backups/
*.tar.gz

# OS
.DS_Store

# browser automation profile (login cookies)
browser-profile/

# runtime logs
logs/

# The Company world — runtime-generated data (regenerated by the sim/builder).
# Ignore the generated props + downloaded tileset PNGs, but keep the tileset
# manifest + README (asset-wiring docs).
static/world_assets/*
!static/world_assets/tilesets/
static/world_assets/tilesets/*
!static/world_assets/tilesets/manifest.json
!static/world_assets/tilesets/README.md
world_agents/
.secret_key
# Graphify knowledge-graph index — built from THIS repo's real content, so it must
# never be committed/shipped; each install rebuilds its own (setup.sh --with-graphify).
graphify-out*/

# Drop-in plugins — user-installed add-ons are never tracked, so they survive
# store updates (that's the whole point of the plugin system). Keep the author
# contract doc tracked. (`plugins/*`, not `plugins/`: git can't re-include a
# file inside a fully-ignored directory.)
plugins/*
!plugins/README.md

# runtime-generated working dirs (not source): staged design renders awaiting
# review, archived job snapshots, and inbound mail attachments.
designs/pending/
designs/approved/thumbs/
archive/
mail_attachments/
models3d/generated/
models3d/backlog/
models3d/hero/
models3d/renders/
videos/
static/docextract_uploads/
designs/sizes/
research_media/
brands/

# Voice (Jarvis) TTS/STT model binaries — large, downloaded on demand (see app/VOICE.md)
app/voice_models/

# Claude Code agent worktrees / local state
.claude/
